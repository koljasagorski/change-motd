render_banner() {
    local host dt
    host="$(hostname -s 2>/dev/null || hostname)"
    dt="$(date '+%a %d %b %Y · %H:%M:%S %Z')"
    rule
    printf '\n'
    banner "$host"
    printf '\n   %s%s  %s·%s  %s%s%s  %s%s%s  %s·%s  %s%s theme%s\n\n' \
        "${C_GRAY}$(distro_glyph) ${DISTRO_PRETTY}${NC}" "" \
        "$C_DIM" "$NC" \
        "$C_PURPLE" "${I_CLOCK}" "$NC" \
        "$C_FG" "$dt" "$NC" \
        "$C_DIM" "$NC" \
        "$C_PINK" "$THEME" "$NC"
    rule
}

# CRITICAL section: only shown if there's something actually wrong.
render_critical() {
    local reboot fu_count oom zomb need_show=0
    reboot="$(reboot_required)"
    fu_count="$(failed_units_count)"
    oom="$(oom_kills_24h)"
    zomb="$(zombie_count)"

    [[ -n "$reboot" ]] && need_show=1
    (( ${fu_count:-0} > 0 )) && need_show=1
    (( ${oom:-0} > 0 )) && need_show=1
    (( ${zomb:-0} > 0 )) && need_show=1
    (( need_show == 0 )) && return 0

    section "$(printf '%s%s%s  Needs Attention' "$C_RED" "$I_WARN" "$NC")"
    if [[ -n "$reboot" ]]; then
        local extra=""
        (( reboot > 0 )) && extra="${C_GRAY} — ${reboot} packages${NC}"
        row "$I_REBOOT" "Reboot" "$(pulse "${C_RED}required${NC}")${extra}"
    fi
    if (( ${fu_count:-0} > 0 )); then
        local units
        units="$(failed_units | head -n3 | tr '\n' ' ' | sed 's/ $//')"
        row "$I_FAIL" "Units" "${C_RED}${fu_count} failed${NC} ${C_GRAY}${units}${NC}"
    fi
    if (( ${oom:-0} > 0 )); then
        row "$I_FIRE" "OOM 24h" "${C_RED}${oom}${NC} ${C_GRAY}kills${NC}"
    fi
    if (( ${zomb:-0} > 0 )); then
        row "$I_GHOST" "Zombies" "${C_YELLOW}${zomb}${NC}"
    fi
}

render_system() {
    section "System"
    local os_line latest cur cpu_m cores threads virt
    cur="$DISTRO_VERSION_ID"
    latest="$(latest_release || true)"
    if [[ -n "$latest" && -n "$cur" && "$latest" != "$cur" ]]; then
        os_line="${DISTRO_PRETTY} ${C_YELLOW}${I_WARN} update available → ${latest}${NC}"
    else
        os_line="${DISTRO_PRETTY} ${C_GREEN}${I_OK} up to date${NC}"
    fi
    row "$I_OS"     "OS"      "$os_line"
    row "$I_KERNEL" "Kernel"  "$(uname -r) ${C_GRAY}($(arch_name))${NC}"
    cpu_m="$(cpu_model)"
    cores="$(cpu_cores)"
    threads="$(cpu_threads)"
    if [[ -n "$cpu_m" ]]; then
        row "$I_CPU" "CPU" "${cpu_m} ${C_GRAY}— ${cores}c/${threads}t${NC}"
    fi
    virt="$(virt_type)"
    [[ -n "$virt" ]] && row "$I_VIRT" "Virt" "${C_CYAN}${virt}${NC}"
    row "$I_UPTIME" "Uptime"  "$(uptime -p 2>/dev/null | sed 's/^up //')"
    local load_spark
    [[ "$SHOW_SPARKLINES" == "1" ]] && load_spark=" ${C_CYAN}$(load_sparkline)${NC}"
    row "$I_LOAD"   "Load"    "$(awk '{printf "%s · %s · %s", $1, $2, $3}' /proc/loadavg)${load_spark:-}"
    local sessions
    sessions="$(active_ssh_count)"
    row "$I_USER"   "Sessions" "${sessions} ${C_GRAY}active${NC}"
}

render_resources() {
    section "Resources"
    local cpu mp mu mt dp du dt sp su st temp gpu fan mbtemp smart
    cpu="$(cpu_pct || echo 0)"
    [[ -z "$cpu" ]] && cpu=0
    read -r mp mu mt < <(mem_info)
    read -r dp du dt < <(disk_info /)
    read -r sp su st < <(swap_info)
    temp="$(cpu_temp_c)"
    gpu="$(gpu_info)"
    fan="$(fan_rpm)"
    mbtemp="$(mb_temp_c)"
    smart="$(smart_health)"

    row "$I_CPU"  "CPU"    "$(draw_bar "$cpu"  24 "$(mood_glyph "$cpu" "${temp:-0}")")"
    row "$I_RAM"  "Memory" "$(draw_bar "${mp:-0}" 24 "${mu:-0} / ${mt:-0} GiB")"

    if [[ "$sp" != "off" && -n "$sp" ]]; then
        row "$I_SWAP" "Swap"  "$(draw_bar "${sp:-0}" 24 "${su:-0} / ${st:-0} GiB")"
    fi

    row "$I_DISK" "Disk /"  "$(draw_bar "${dp:-0}" 24 "${du:-0} / ${dt:-0} GiB")"

    # Show extra mounts (skip root since already shown). Limit to 3 extras.
    local count=0
    while read -r mp_path pct used size; do
        [[ "$mp_path" == "/" || -z "$mp_path" ]] && continue
        (( count++ >= 3 )) && break
        local p="${pct%%%}"
        row "$I_DISK" "Disk ${mp_path}" "$(draw_bar "$p" 24 "${used} / ${size}")"
    done < <(all_disks)

    if [[ -n "$temp" ]]; then
        local tcol="$C_GREEN"
        (( temp >= 70 )) && tcol="$C_YELLOW"
        (( temp >= 85 )) && tcol="${BLINK}${C_RED}"
        local extras=""
        [[ -n "$mbtemp" ]] && extras+=" ${C_GRAY}· board ${mbtemp}°C${NC}"
        [[ -n "$fan" ]]    && extras+=" ${C_GRAY}· fan ${fan} RPM${NC}"
        row "$I_TEMP" "Temp" "${tcol}${temp}°C${NC}${extras}"
    fi

    if [[ -n "$gpu" ]]; then
        row "$I_GPU" "GPU" "${C_CYAN}${gpu}${NC}"
    fi

    if [[ -n "$smart" ]]; then
        local sc
        if [[ "$smart" == *FAIL* || "$smart" == *fail* ]]; then sc="$C_RED"
        else sc="$C_GREEN"
        fi
        row "$I_DISK" "SMART" "${sc}${smart}${NC}"
    fi
}

render_network() {
    section "Network"
    local v4 v6 ext geo country city ip_line gw dns ls speed_str vpn ping_ms conn lst rx tx iface
    v4="$(ipv4_addr)"
    v6="$(ipv6_addr)"
    ext="$(ext_ip)"
    gw="$(default_gw)"
    dns="$(dns_resolver)"
    vpn="$(vpn_status)"
    ping_ms="$(ping_latency)"
    conn="$(conn_count)"
    lst="$(listen_ports_count)"

    [[ -n "$v4" ]] && {
        local rdv4
        rdv4="$(rdns "$v4")"; [[ -z "$rdv4" ]] && rdv4="—"
        row "$I_NET" "IPv4" "${v4}  ${C_GRAY}→ ${rdv4}${NC}"
    }
    [[ -n "$v6" ]] && row "$I_NET" "IPv6" "$v6"
    if [[ -n "$ext" ]]; then
        geo="$(geoip "$ext")"
        country="$(geo_field "$geo" "country")"
        city="$(geo_field "$geo" "city")"
        local rdex
        rdex="$(rdns "$ext")"; [[ -z "$rdex" ]] && rdex="—"
        local geo_label=""
        [[ -n "$country" ]] && geo_label="${I_FLAG} ${country}"
        [[ -n "$city" ]]    && geo_label="${geo_label} · ${city}"
        row "$I_GLOBE" "External" "${ext}  ${C_GRAY}→ ${rdex}${NC}  ${C_PINK}${geo_label}${NC}"
    fi
    [[ -n "$gw" ]]  && row "$I_GATE" "Gateway" "$gw"
    [[ -n "$dns" ]] && row "$I_DNS"  "DNS"     "$dns"

    ls="$(link_speed_mbps)"
    if [[ -n "$ls" ]]; then
        read -r iface speed_str <<<"$ls"
        local lc="$C_GREEN"
        (( speed_str < 100 )) && lc="$C_YELLOW"
        (( speed_str < 10  )) && lc="$C_RED"
        row "$I_LINK" "Link" "${iface} ${C_GRAY}@${NC} ${lc}${speed_str} Mbit/s${NC}"
    fi

    if [[ -n "$ping_ms" ]]; then
        local pc="$C_GREEN"
        local ms_int=${ping_ms%.*}
        (( ms_int > 50 ))  && pc="$C_YELLOW"
        (( ms_int > 200 )) && pc="$C_RED"
        row "$I_PING" "Ping" "${pc}${ping_ms} ms${NC} ${C_GRAY}to ${PING_HOST}${NC}"
    fi

    read -r rx tx < <(net_traffic)
    if [[ -n "${rx:-}" && "$rx" != "0" ]]; then
        row "$I_NET" "Traffic" "${C_TEAL}${I_DOWN} $(fmt_bytes "$rx")${NC}  ${C_PINK}${I_UP} $(fmt_bytes "$tx")${NC}  ${C_GRAY}since boot${NC}"
    fi

    if [[ -n "$conn" || -n "$lst" ]]; then
        row "$I_NET" "Sockets" "${C_FG}${conn:-0}${NC} ${C_GRAY}est.${NC}  ${C_FG}${lst:-0}${NC} ${C_GRAY}listening${NC}"
    fi

    [[ -n "$vpn" ]] && row "$I_VPN" "VPN" "${C_GREEN}${vpn}${NC}"
}

render_security() {
    local fail2 ssh tor ufw mac ntp need=0
    fail2="$(fail2ban_summary)"
    ssh="$(failed_ssh_24h || echo 0)"
    tor="$(tor_status)"
    ufw="$(ufw_status)"
    mac="$(mac_status)"
    ntp="$(ntp_status)"
    local sessions
    mapfile -t sessions < <(active_ssh_sessions)

    [[ -n "$fail2" ]] && need=1
    [[ -n "$tor" ]] && need=1
    [[ -n "$ufw" ]] && need=1
    [[ -n "$mac" ]] && need=1
    [[ -n "$ntp" ]] && need=1
    (( ssh > 0 )) && need=1
    (( ${#sessions[@]} > 0 )) && need=1
    (( need == 0 )) && return 0

    section "Security"
    if [[ -n "$fail2" ]]; then
        read -r jails banned <<<"$fail2"
        row "$I_SHIELD" "Fail2Ban" "${C_GREEN}${I_OK} active${NC}  ${C_GRAY}— ${jails} jails, ${banned} banned${NC}"
    fi
    if (( ssh > 0 )); then
        local col="$C_GREEN"
        (( ssh > 10 )) && col="$C_YELLOW"
        (( ssh > 50 )) && col="$C_RED"
        local spark=""
        [[ "$SHOW_SPARKLINES" == "1" ]] && spark=" ${C_GRAY}$(ssh_history_sparkline)${NC}"
        row "$I_LOCK" "SSH (24h)" "${col}${ssh}${NC} ${C_GRAY}failed${NC}${spark}"
    fi
    if (( ${#sessions[@]} > 0 )); then
        row "$I_KEY" "Active" "${C_TEAL}${sessions[*]}${NC}"
    fi
    if [[ -n "$ufw" ]]; then
        local uc="$C_GREEN"; [[ "$ufw" == *inactive* ]] && uc="$C_YELLOW"
        row "$I_SHIELD" "UFW" "${uc}${ufw}${NC}"
    fi
    if [[ -n "$mac" ]]; then
        row "$I_SHIELD" "MAC" "${C_BLUE}${mac}${NC}"
    fi
    if [[ -n "$ntp" ]]; then
        local nc; [[ "$ntp" == "synced" ]] && nc="$C_GREEN" || nc="$C_RED"
        row "$I_CLOCK" "NTP" "${nc}${ntp}${NC}"
    fi
    if [[ -n "$tor" ]]; then
        if [[ "$tor" == "active" ]]; then
            row "$I_TOR" "Tor" "${C_GREEN}${I_OK} active${NC}"
        else
            row "$I_TOR" "Tor" "${C_RED}${I_FAIL} inactive${NC}"
        fi
    fi
}

render_updates() {
    local out
    out="$(apt_updates)"
    [[ -z "$out" ]] && return 0
    read -r total sec <<<"$out"
    section "Updates"
    local col="$C_GREEN" ico="$I_OK"
    (( total > 0 )) && { col="$C_YELLOW"; ico="$I_WARN"; }
    (( sec > 0 ))   && { col="$C_RED";    ico="$I_FAIL"; }
    row "$I_UPDATE" "Available" "${col}${ico} ${total}${NC} ${C_GRAY}packages${NC}"
    row "$I_LOCK"   "Security"  "${col}${sec}${NC} ${C_GRAY}critical${NC}"
}

render_certs() {
    [[ -z "$CERT_DOMAINS" ]] && return 0
    section "TLS Certificates"
    local d days col
    for d in $CERT_DOMAINS; do
        days="$(tls_expiry_days "$d")"
        if [[ -z "$days" ]]; then
            row "$I_CERT" "$d" "${C_GRAY}— unreachable${NC}"
            continue
        fi
        col="$C_GREEN"
        (( days < 30 )) && col="$C_YELLOW"
        (( days < 7  )) && col="$C_RED"
        row "$I_CERT" "$d" "${col}${days} days${NC}"
    done
}

render_schedule() {
    local backup next show=0
    backup="$(last_backup_human)"
    next="$(next_scheduled)"
    [[ -n "$backup" ]] && show=1
    [[ -n "$next" ]] && show=1
    (( show == 0 )) && return 0

    section "Schedule"
    if [[ -n "$backup" ]]; then
        row "$I_BACKUP" "Backup" "${C_FG}${backup}${NC} ${C_GRAY}— ${BACKUP_PATH}${NC}"
    fi
    if [[ -n "$next" ]]; then
        row "$I_CRON" "Next job" "${C_FG}${next}${NC}"
    fi
}

render_containers() {
    local d
    d="$(docker_status)"
    [[ -z "$d" ]] && return 0
    read -r running total <<<"$d"
    section "Containers"
    row "$I_DOCKER" "Docker" "${C_GREEN}${running}${NC} ${C_GRAY}running${NC} · ${total} total"
}

render_lastlogin() {
    local line user term ip when
    line="$(last -i -F 2>/dev/null \
        | awk '$1 != "" && $1 != "reboot" && $1 != "wtmp" && $0 !~ /still logged in/ {print; exit}')"
    [[ -z "$line" ]] && return 0
    user="$(awk '{print $1}' <<<"$line")"
    term="$(awk '{print $2}' <<<"$line")"
    ip="$(awk '{print $3}' <<<"$line")"
    when="$(awk '{print $4, $5, $6, $7, $8}' <<<"$line")"
    section "Last Login"
    row "$I_USER" "User" "${BOLD}${user}${NC}  ${C_GRAY}via ${term}${NC}"
    row "$I_NET"  "From" "${ip:-—}"
    row "$I_LAST" "When" "$when"
}

render_processes() {
    section "Top Processes"
    printf '     %s%-8s %-22s %8s %8s%s\n' \
        "$C_GRAY" "PID" "COMMAND" "CPU" "MEM" "$NC"
    ps -eo pid,comm,%cpu,%mem --sort=-%cpu --no-headers 2>/dev/null \
        | head -n 5 \
        | awk -v c="$C_FG" -v g="$C_GRAY" -v p="$C_PURPLE" -v r="$NC" \
            '{printf "     %s%-8s%s %s%-22s%s %s%8s%s %s%8s%s\n", p, $1, r, c, $2, r, c, $3, r, g, $4, r}'
}

render_footer() {
    rule
    local w q f
    w="$(weather_line)"
    q="$(random_quote)"
    f="$(funfact)"
    [[ -n "$w" ]] && printf '   %s%s%s  %s%s%s\n' "$C_BLUE"   "$I_WEATHER" "$NC" "$C_CYAN" "$w" "$NC"
    [[ -n "$f" ]] && printf '   %s%s%s  %s%s%s\n' "$C_PINK"   "$I_CLOCK"   "$NC" "$C_FG"   "$f" "$NC"
    [[ -n "$q" ]] && printf '   %s%s%s  %s%s%s\n' "$C_PURPLE" "$I_BOLT"    "$NC" "$C_GRAY" "$q" "$NC"
}

# =============================================================================
# Main
# =============================================================================

main() {
    render_banner
    render_critical
    render_system
    render_resources
    render_network
    render_security
    render_updates
    render_certs
    render_schedule
    render_containers
    render_lastlogin
    render_processes
    printf '\n'
    render_footer
}

main "$@"
