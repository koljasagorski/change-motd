# =============================================================================
# Generic helpers
# =============================================================================

strip_ansi() {
    # shellcheck disable=SC2001
    sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' <<<"$1"
}

vwidth() {
    local s
    s="$(strip_ansi "$1")"
    printf '%s' "${#s}"
}

repeat() {
    local s="$1" n="${2:-0}" out=""
    (( n < 0 )) && n=0
    while (( n-- > 0 )); do out+="$s"; done
    printf '%s' "$out"
}

have() { command -v "$1" >/dev/null 2>&1; }

# Cache the output of a command on disk. Returns stale cache on failure.
cached() {
    local key="$1" ttl="$2"
    shift 2
    [[ "${1:-}" == "--" ]] && shift
    local file="$CACHE_DIR/$key"
    local now age
    now="$(date +%s)"
    if [[ -f "$file" ]]; then
        age=$(( now - $(stat -c %Y "$file" 2>/dev/null || echo 0) ))
        if (( age < ttl )); then
            cat "$file"
            return 0
        fi
    fi
    local out
    if out="$("$@" 2>/dev/null)" && [[ -n "$out" ]]; then
        printf '%s' "$out" > "$file" 2>/dev/null || true
        printf '%s' "$out"
    elif [[ -f "$file" ]]; then
        cat "$file"
    fi
}

# Human-readable bytes.
fmt_bytes() {
    local b="${1:-0}"
    awk -v b="$b" 'BEGIN {
        split("B KiB MiB GiB TiB PiB", u);
        i=1;
        while (b >= 1024 && i < 6) { b/=1024; i++ }
        printf (i==1) ? "%d %s" : "%.1f %s", b, u[i]
    }'
}

# Unicode sparkline: takes integers as args, prints a single-row sparkline.
sparkline() {
    local chars=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)
    local max=0 n cmp
    for n in "$@"; do
        cmp="${n%.*}"
        [[ "$cmp" =~ ^-?[0-9]+$ ]] || cmp=0
        (( cmp > max )) && max=$cmp
    done
    (( max == 0 )) && max=1
    local out=""
    for n in "$@"; do
        cmp="${n%.*}"
        [[ "$cmp" =~ ^-?[0-9]+$ ]] || cmp=0
        (( cmp < 0 )) && cmp=0
        local idx=$(( cmp * 7 / max ))
        (( idx > 7 )) && idx=7
        out+="${chars[$idx]}"
    done
    printf '%s' "$out"
}

# Pulse-glow for critical values (\e[5m blink — supported by xterm, gnome, kitty, alacritty).
pulse() {
    printf '%s%s%s' "$BLINK" "$1" "$NC"
}

