# /etc/default/motd may override any MOTD_* variable.
# shellcheck disable=SC1091
[[ -r /etc/default/motd ]] && . /etc/default/motd

WEATHER_CITY="${MOTD_WEATHER_CITY:-}"
PING_HOST="${MOTD_PING_HOST:-1.1.1.1}"
