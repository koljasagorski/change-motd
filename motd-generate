ipv4_addr() { hostname -I 2>/dev/null | awk '{print $1}'; }
ipv6_addr() { ip -6 addr show scope global 2>/dev/null | awk '/inet6/ {print $2; exit}' | cut -d/ -f1; }
default_gw() { ip route 2>/dev/null | awk '/^default/ {print $3; exit}'; }
dns_resolver() {
    if have resolvectl; then
        resolvectl status 2>/dev/null | awk '/Current DNS Server/ {print $NF; exit}'
    fi
    [[ -r /etc/resolv.conf ]] && awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf
}

net_traffic() {
    # Returns: <rx_bytes> <tx_bytes> across all non-lo interfaces.
    awk 'NR>2 {iface=$1; gsub(":","",iface); if(iface!="lo"){rx+=$2; tx+=$10}} END {printf "%d %d", rx, tx}' \
        /proc/net/dev
}

primary_iface() {
    ip -br link 2>/dev/null | awk '$2 == "UP" && $1 != "lo" {print $1; exit}'
}

link_speed_mbps() {
    local iface
    iface="$(primary_iface)"
    [[ -z "$iface" ]] && return 0
    [[ -r "/sys/class/net/$iface/speed" ]] || return 0
    local s
    s="$(cat "/sys/class/net/$iface/speed" 2>/dev/null)"
    [[ "$s" =~ ^[0-9]+$ ]] && printf '%s %s' "$iface" "$s"
}

conn_count() {
    have ss || return 0
    ss -tu state established 2>/dev/null | tail -n +2 | wc -l
}

listen_ports_count() {
    have ss || return 0
    ss -tlnH 2>/dev/null | wc -l
}

vpn_status() {
    local tunnels=""
    if have wg; then
        local n
        n="$(wg show interfaces 2>/dev/null | wc -w)"
        (( n > 0 )) && tunnels+="WireGuard:${n} "
    fi
    local tun_count
    tun_count="$(ip -br link 2>/dev/null | awk '/^(tun|tap|nordlynx|proton|mullvad)/ {n++} END {print n+0}')"
    (( tun_count > 0 )) && tunnels+="TUN:${tun_count} "
    printf '%s' "${tunnels% }"
}

ping_latency() {
    have ping || return 0
    ping -c 1 -W 1 "$PING_HOST" 2>/dev/null \
        | awk -F'[=/ ]+' '/time=/ {for(i=1;i<=NF;i++) if($i=="time"){printf "%.1f", $(i+1); exit}}'
}

ext_ip() {
    cached "extip" "$TTL_EXTIP" -- curl -fsSL --max-time "$HTTP_TIMEOUT" https://ifconfig.me
}

geoip() {
    local ip="$1"
    [[ -z "$ip" ]] && return 0
    cached "geo_$ip" "$TTL_GEOIP" -- \
        curl -fsSL --max-time "$HTTP_TIMEOUT" "https://ipinfo.io/${ip}/json"
}

geo_field() {
    local json="$1" key="$2"
    [[ -z "$json" ]] && return 0
    if have jq; then
        jq -r --arg k "$key" '.[$k] // empty' <<<"$json" 2>/dev/null
    else
        grep -Po "\"$key\"\\s*:\\s*\"\\K[^\"]+" <<<"$json" | head -n1
    fi
}

rdns() {
    local ip="$1"
    [[ -z "$ip" ]] && return 0
    if have getent; then
        getent hosts "$ip" 2>/dev/null | awk '{print $2}' | head -n1
    elif have host; then
        host "$ip" 2>/dev/null | awk '/domain name pointer/ {print $5; exit}' | sed 's/\.$//'
    fi
}

