failed_ssh_24h() {
    if have journalctl; then
        journalctl --since "24 hours ago" --no-pager 2>/dev/null \
            | grep -Ec 'Failed (password|publickey)|Invalid user|authentication failure' \
            || true
    elif [[ -r /var/log/auth.log ]]; then
        grep -Ec "Failed (password|publickey)|Invalid user" /var/log/auth.log 2>/dev/null || true
    else
        printf '0'
    fi
}

# Sparkline of failed SSH attempts over 12 × 2h buckets in the last 24h.
ssh_history_sparkline() {
    have journalctl || return 0
    local i bucket=""
    local since_ts now_ts
    now_ts="$(date +%s)"
    local out=()
    for (( i=11; i>=0; i-- )); do
        local from=$(( now_ts - (i+1) * 7200 ))
        local to=$(( now_ts - i * 7200 ))
        local from_str to_str
        from_str="$(date -d "@$from" '+%Y-%m-%d %H:%M:%S')"
        to_str="$(date -d "@$to" '+%Y-%m-%d %H:%M:%S')"
        local c
        c="$(journalctl --since "$from_str" --until "$to_str" --no-pager 2>/dev/null \
            | grep -Ec 'Failed (password|publickey)|Invalid user|authentication failure' || true)"
        out+=("${c:-0}")
    done
    sparkline "${out[@]}"
}

# Sparkline of 1m loadavg over the last 12 samples from sar (if available).
load_sparkline() {
    if have sar; then
        # sar -q gives loadavg history
        local samples
        samples="$(LC_ALL=C sar -q 2>/dev/null \
            | awk '/^[0-9]/ {printf "%.0f ", $4*100}' \
            | tail -c 100)"
        if [[ -n "$samples" ]]; then
            # shellcheck disable=SC2086
            sparkline $samples
            return
        fi
    fi
    # Fallback: three samples from /proc/loadavg.
    awk '{printf "%d %d %d\n", $1*100, $2*100, $3*100}' /proc/loadavg \
        | { read -r a b c; sparkline "$a" "$b" "$c"; }
}

active_ssh_sessions() {
    who 2>/dev/null | awk '$NF ~ /^\(/ {print $1"@"substr($NF,2,length($NF)-2)}' | sort -u
}

active_ssh_count() {
