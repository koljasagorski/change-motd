#!/usr/bin/env bash
# motd-generate — A beautiful, nerdy Message of the Day for Linux servers
# https://github.com/koljasagorski/change-motd
#
# This script is intended to be called by /etc/update-motd.d/ so the MOTD
# regenerates on every login. It writes the rendered MOTD to stdout.

set -uo pipefail
