}

mac_status() {
    if have aa-status; then
        if aa-status --enabled 2>/dev/null; then
            local n
            n="$(aa-status --profiled 2>/dev/null || echo 0)"
            printf 'AppArmor:on(%s)' "$n"
        fi
    elif have getenforce; then
        local s
        s="$(getenforce 2>/dev/null)"
        [[ -n "$s" ]] && printf 'SELinux:%s' "$s"
    fi
}

ufw_status() {
    have ufw || return 0
    sudo -n ufw status 2>/dev/null | head -n1 | awk -F: '{gsub(/^ +/,"",$2); print $2}' \
        || ufw status 2>/dev/null | head -n1 | awk -F: '{gsub(/^ +/,"",$2); print $2}'
