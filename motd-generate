# Get figlet output as an array. Returns 1 if figlet missing.
_figlet_lines() {
    have figlet || return 1
    local text="$1"
    local raw
    raw="$(figlet -f standard -w "$WIDTH" -- "$text" 2>/dev/null \
        || figlet -w "$WIDTH" -- "$text" 2>/dev/null)"
    [[ -z "$raw" ]] && return 1
    # shellcheck disable=SC2034
    mapfile -t _fl <<<"$raw"
    while (( ${#_fl[@]} > 0 )) && [[ -z "${_fl[-1]// /}" ]]; do
        unset '_fl[-1]'
    done
    return 0
}

_max_line_width() {
    local -n arr=$1
    local m=0 l
    for l in "${arr[@]}"; do (( ${#l} > m )) && m=${#l}; done
    printf '%s' "$m"
}

# Plain (non-animated) banner — also used as fallback.
banner_static() {
    local text="$1"
    local _fl
    if ! _figlet_lines "$text"; then
        printf '  %s%s%s\n' "$BOLD" "$text" "$NC"
        return
    fi
    local cols i c idx
    cols="$(_max_line_width _fl)"
    for l in "${_fl[@]}"; do
        printf '  '
        for ((i=0; i<${#l}; i++)); do
            c="${l:i:1}"
            [[ "$c" == " " ]] && { printf ' '; continue; }
            idx=$(( i * (${#GRADIENT[@]} - 1) / (cols > 0 ? cols : 1) ))
            (( idx >= ${#GRADIENT[@]} )) && idx=$(( ${#GRADIENT[@]} - 1 ))
            printf '\e[38;2;%sm%s' "${GRADIENT[$idx]}" "$c"
        done
        printf '%s\n' "$NC"
    done
}

# Type-out: char-by-char with gradient.
anim_typeout() {
    local text="$1"
    local _fl
    _figlet_lines "$text" || { printf '  %s\n' "$text"; return; }
    local cols i c idx
    cols="$(_max_line_width _fl)"
    for l in "${_fl[@]}"; do
        printf '  '
        for ((i=0; i<${#l}; i++)); do
            c="${l:i:1}"
            if [[ "$c" == " " ]]; then printf ' '; continue; fi
            idx=$(( i * (${#GRADIENT[@]} - 1) / (cols > 0 ? cols : 1) ))
            (( idx >= ${#GRADIENT[@]} )) && idx=$(( ${#GRADIENT[@]} - 1 ))
            printf '\e[38;2;%sm%s' "${GRADIENT[$idx]}" "$c"
            sleep 0.004
        done
        printf '%s\n' "$NC"
    done
}

# Decrypt: random glyphs settle into the real characters.
anim_decrypt() {
    local text="$1"
    local _fl
    _figlet_lines "$text" || { printf '  %s\n' "$text"; return; }
    local cols n=${#_fl[@]} cs='!@#$%^&*?+/=ABCDEF0123456789'
    cols="$(_max_line_width _fl)"
    local frames=8 frame i l c idx rc

    # Reserve N lines.
    for ((i=0; i<n; i++)); do printf '\n'; done

    for ((frame=1; frame<=frames; frame++)); do
        printf '\e[%dA' "$n"
        for l in "${_fl[@]}"; do
            printf '\r\e[K  '
            for ((i=0; i<${#l}; i++)); do
                c="${l:i:1}"
                if [[ "$c" == " " ]]; then printf ' '; continue; fi
                idx=$(( i * (${#GRADIENT[@]} - 1) / (cols > 0 ? cols : 1) ))
                (( idx >= ${#GRADIENT[@]} )) && idx=$(( ${#GRADIENT[@]} - 1 ))
                if (( frame >= frames || RANDOM % frames < frame )); then
                    printf '\e[38;2;%sm%s' "${GRADIENT[$idx]}" "$c"
                else
                    rc="${cs:$((RANDOM % ${#cs})):1}"
                    printf '\e[38;2;%d;%d;%dm%s' \
                        "$((80 + RANDOM % 175))" "$((80 + RANDOM % 175))" "$((80 + RANDOM % 175))" "$rc"
                fi
            done
            printf '%s\n' "$NC"
        done
        sleep 0.04
    done
}

# Glitch: flash the banner with random characters a few times, then settle.
anim_glitch() {
    local text="$1"
    local _fl
    _figlet_lines "$text" || { printf '  %s\n' "$text"; return; }
    local n=${#_fl[@]} cols i l c idx
    cols="$(_max_line_width _fl)"
    banner_static "$text"
    local gcs='!@#$%^&*~/\\|<>=+_'
    local frame
    for frame in 1 2 3; do
        sleep 0.07
        printf '\e[%dA' "$n"
        for l in "${_fl[@]}"; do
            printf '\r\e[K  '
            for ((i=0; i<${#l}; i++)); do
                c="${l:i:1}"
                if [[ "$c" == " " ]]; then printf ' '; continue; fi
                if (( RANDOM % 5 == 0 )); then
                    local gc="${gcs:$((RANDOM % ${#gcs})):1}"
                    printf '\e[38;2;%d;%d;%dm%s' \
                        "$((180 + RANDOM % 75))" "$((RANDOM % 80))" "$((RANDOM % 80))" "$gc"
                else
                    idx=$(( i * (${#GRADIENT[@]} - 1) / (cols > 0 ? cols : 1) ))
                    (( idx >= ${#GRADIENT[@]} )) && idx=$(( ${#GRADIENT[@]} - 1 ))
                    printf '\e[38;2;%sm%s' "${GRADIENT[$idx]}" "$c"
                fi
            done
            printf '%s\n' "$NC"
        done
    done
    sleep 0.07
    printf '\e[%dA' "$n"
    banner_static "$text"
}

# Matrix rain that condenses into the banner.
anim_matrix() {
    local text="$1"
    local _fl
    _figlet_lines "$text" || { printf '  %s\n' "$text"; return; }
    local n=${#_fl[@]} cols i l c idx
    cols="$(_max_line_width _fl)"
    local rcs='01アイウエオカキクケコサシスセソタチツテト'
    local frames=10 frame
    for ((i=0; i<n; i++)); do printf '\n'; done
    for ((frame=1; frame<=frames; frame++)); do
        printf '\e[%dA' "$n"
        for l in "${_fl[@]}"; do
            printf '\r\e[K  '
            for ((i=0; i<${#l}; i++)); do
                c="${l:i:1}"
                if (( frame > frames - 3 )); then
                    [[ "$c" == " " ]] && { printf ' '; continue; }
                    idx=$(( i * (${#GRADIENT[@]} - 1) / (cols > 0 ? cols : 1) ))
                    (( idx >= ${#GRADIENT[@]} )) && idx=$(( ${#GRADIENT[@]} - 1 ))
                    printf '\e[38;2;%sm%s' "${GRADIENT[$idx]}" "$c"
                else
                    if (( RANDOM % 2 == 0 )); then
                        local mc="${rcs:$((RANDOM % ${#rcs})):1}"
                        printf '\e[38;2;%d;255;%dm%s' "$((RANDOM % 80))" "$((RANDOM % 80))" "$mc"
                    else
                        printf ' '
                    fi
                fi
            done
            printf '%s\n' "$NC"
        done
        sleep 0.05
    done
}

# Power-on / BIOS boot sequence then the banner.
anim_boot() {
    local text="$1"
    local lines=(
        "[    0.000000] Linux version $(uname -r)"
        "[    0.012345] CPU0: $(cpu_model 2>/dev/null | head -c 40)"
        "[    0.234567] PCI: Probing PCI hardware"
        "[    1.123456] systemd[1]: Detected virtualization $(virt_type 2>/dev/null || echo bare-metal)"
        "[    1.234567] systemd[1]: Starting Apply Kernel Variables..."
        "[    1.345678] systemd[1]: Mounted /sys"
        "[    1.456789] systemd[1]: Started Network Manager"
        "[    1.567890] systemd[1]: Started OpenSSH server daemon"
        "[    1.678901] systemd[1]: Reached target Multi-User System"
        "[    1.789012] motd[1337]: Initializing nerdy MOTD..."
    )
    local l
    for l in "${lines[@]}"; do
        printf '%s%s%s\n' "$C_DIM" "$l" "$NC"
        sleep 0.05
    done
    sleep 0.15
    banner_static "$text"
}

# Dispatcher.
banner() {
    case "$ANIMATE" in
        matrix)  anim_matrix  "$1" ;;
        decrypt) anim_decrypt "$1" ;;
        glitch)  anim_glitch  "$1" ;;
        type)    anim_typeout "$1" ;;
        boot)    anim_boot    "$1" ;;
        *)       banner_static "$1" ;;
    esac
}

# =============================================================================
# Rendering — building blocks
# =============================================================================

section() {
    local title="$1"
    local pre="  ${C_PURPLE}▎${NC}  ${BOLD}${C_FG}${title}${NC}  "
    local pre_w
    pre_w="$(vwidth "$pre")"
    local rule_w=$(( WIDTH - pre_w ))
    (( rule_w < 4 )) && rule_w=4
    printf '\n%s%s%s%s\n' "$pre" "$C_DIM" "$(repeat '─' "$rule_w")" "$NC"
}

rule() {
    printf '%s%s%s\n' "$C_DIM" "$(repeat '━' "$WIDTH")" "$NC"
}

row() {
    local icon="$1" label="$2" value="$3"
    printf '     %s%s%s  %s%-12s%s %s\n' \
        "$C_PURPLE" "$icon" "$NC" \
        "$C_GRAY" "$label" "$NC" \
        "$value"
}

color_pct() {
    local p="${1:-0}"
    if   (( p < 50 )); then printf '%s' "$C_GREEN"
    elif (( p < 80 )); then printf '%s' "$C_YELLOW"
    else                    printf '%s' "$C_RED"
    fi
}

draw_bar() {
    local pct="${1:-0}" bar_w="${2:-24}" suffix="${3:-}"
    [[ "$pct" =~ ^[0-9]+$ ]] || pct=0
    (( pct > 100 )) && pct=100
    local filled=$(( pct * bar_w / 100 ))
    local empty=$(( bar_w - filled ))
    local col
    col="$(color_pct "$pct")"
    printf '%s[%s%s%s%s%s%s%s] %s%3d%%%s  %s%s%s' \
        "$C_DIM" "$NC" \
        "$col" "$(repeat '█' "$filled")" "$NC" \
        "$C_DIM" "$(repeat '░' "$empty")" "$NC" \
        "$col" "$pct" "$NC" \
        "$C_GRAY" "$suffix" "$NC"
}

# Animated bar that fills from 0 → pct over ~250 ms.
draw_bar_animated() {
    local pct="${1:-0}" bar_w="${2:-24}" suffix="${3:-}"
    [[ "$pct" =~ ^[0-9]+$ ]] || pct=0
    (( pct > 100 )) && pct=100
    local steps=12 i
    for ((i=1; i<=steps; i++)); do
        local p=$(( pct * i / steps ))
        printf '\r     %s%s%s  %s%-12s%s %s' \
            "$C_PURPLE" "$I_BOLT" "$NC" \
            "$C_GRAY" "" "$NC" \
            "$(draw_bar "$p" "$bar_w" "")"
        sleep 0.015
    done
    # Final state with proper suffix (cleared and re-drawn).
    printf '\r\e[K'
}

# Mood-Tux glyph based on temperature and load.
mood_glyph() {
    local cpu="${1:-0}" temp="${2:-0}"
    [[ "$cpu" =~ ^[0-9]+$ ]]  || cpu=0
    [[ "$temp" =~ ^[0-9]+$ ]] || temp=0
    if   (( temp >= 85 )); then printf '🔥'
    elif (( temp >= 70 )); then printf '🥵'
    elif (( cpu  >= 90 )); then printf '😰'
    elif (( cpu  >= 70 )); then printf '😅'
    elif (( cpu  >= 40 )); then printf '🙂'
    else                        printf '😴'
    fi
}

