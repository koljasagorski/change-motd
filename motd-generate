# =============================================================================
# Data collection — system & hardware
# =============================================================================

cpu_model() {
    awk -F: '/^model name/ {sub(/^[ \t]+/,"",$2); print $2; exit}' /proc/cpuinfo
}
cpu_cores()   { nproc 2>/dev/null; }
cpu_threads() { grep -c '^processor' /proc/cpuinfo 2>/dev/null; }
arch_name()   { uname -m; }

virt_type() {
    have systemd-detect-virt || return 0
    local v
    v="$(systemd-detect-virt 2>/dev/null)"
    [[ "$v" == "none" || -z "$v" ]] && return 0
    printf '%s' "$v"
}

cpu_pct() {
    top -bn1 \
        | awk -F'[ ,]+' '/Cpu\(s\)/ {for(i=1;i<=NF;i++) if($i~/id/){print int(100 - $(i-1) + 0.5); exit}}'
}

mem_info() {
    free -b | awk '/^Mem:/ {
        used=$3; total=$2;
        printf "%d %.1f %.1f", (used*100/total)+0.5, used/1073741824, total/1073741824
    }'
}

swap_info() {
    free -b | awk '/^Swap:/ {
        if ($2 == 0) { printf "off 0 0"; next }
        used=$3; total=$2;
        printf "%d %.1f %.1f", (used*100/total)+0.5, used/1073741824, total/1073741824
    }'
}

disk_info() {
    local path="${1:-/}"
    df -B1 --output=pcent,used,size "$path" 2>/dev/null | awk 'NR==2 {
        gsub("%","",$1);
        printf "%d %.1f %.1f", $1, $2/1073741824, $3/1073741824
    }'
}

# All real filesystems with their mount/use%/size.
all_disks() {
    df -h --output=target,pcent,used,size \
        -x tmpfs -x devtmpfs -x squashfs -x overlay -x proc -x sysfs 2>/dev/null \
        | awk 'NR>1 && $1 != ""'
}

smart_health() {
    have smartctl || return 0
    local d health out=""
    for d in /dev/sd? /dev/nvme?n? /dev/hd?; do
        [[ -b "$d" ]] || continue
        health="$(sudo -n smartctl -H "$d" 2>/dev/null \
            | awk -F: '/overall-health|SMART Health Status/ {gsub(/^ +/,"",$2); print $2; exit}')"
        if [[ -z "$health" ]]; then
            # Try without sudo (smartctl needs root on most kernels; skip silently).
            health="$(smartctl -H "$d" 2>/dev/null \
                | awk -F: '/overall-health|SMART Health Status/ {gsub(/^ +/,"",$2); print $2; exit}')"
        fi
        [[ -n "$health" ]] && out+="${d##*/}:${health} "
    done
    printf '%s' "${out% }"
}

gpu_info() {
    if have nvidia-smi; then
        nvidia-smi --query-gpu=name,temperature.gpu,utilization.gpu \
                   --format=csv,noheader,nounits 2>/dev/null | head -n1 \
            | awk -F, '{gsub(/^ +| +$/,"",$1); gsub(/^ +/,"",$2); gsub(/^ +/,"",$3);
                       printf "%s · %s°C · %s%%", $1, $2, $3}'
    elif have lspci; then
        lspci 2>/dev/null \
            | awk -F: '/VGA|3D controller/ {sub(/^ +/,"",$3); print $3; exit}'
    fi
}

cpu_temp_c() {
    local val=""
    if have sensors; then
        val="$(sensors 2>/dev/null \
            | awk '/^(Package id 0|Tctl|Tdie|Core 0):/ {gsub(/\+|°C/,"",$NF); print int($NF+0.5); exit}')"
    fi
    if [[ -z "$val" ]]; then
        for f in /sys/class/thermal/thermal_zone*/temp; do
            [[ -r "$f" ]] || continue
            local raw
            raw="$(cat "$f" 2>/dev/null || true)"
            [[ "$raw" =~ ^[0-9]+$ ]] || continue
            val=$(( raw / 1000 ))
            break
        done
    fi
    printf '%s' "$val"
}

fan_rpm() {
    have sensors || return 0
    sensors 2>/dev/null | awk '/^fan/ {gsub("RPM","",$2); print $2; exit}'
}

mb_temp_c() {
    have sensors || return 0
    sensors 2>/dev/null \
        | awk '/^(Mainboard|Systemin|SYSTIN|temp1|board):/ {gsub(/\+|°C/,"",$NF); print int($NF+0.5); exit}'
}

