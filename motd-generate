oom_kills_24h() {
    have journalctl || return 0
    journalctl --since "24 hours ago" --no-pager 2>/dev/null \
        | grep -Ec 'oom-kill|Killed process|Out of memory' || true
}

zombie_count() {
    ps -eo state --no-headers 2>/dev/null | awk '/^Z/' | wc -l
}

ntp_status() {
    have timedatectl || return 0
    local synced
    synced="$(timedatectl show -p NTPSynchronized --value 2>/dev/null)"
    [[ -z "$synced" ]] && return 0
    if [[ "$synced" == "yes" ]]; then printf 'synced'; else printf 'unsynced'; fi
}

apt_updates() {
    have apt >/dev/null || return 0
    cached "apt_updates" "$TTL_UPDATES" -- bash -c '
        out="$(apt list --upgradable 2>/dev/null | tail -n +2)"
        all=$(printf "%s\n" "$out" | grep -c .)
        sec=$(printf "%s\n" "$out" | grep -ci security)
        printf "%d %d" "$all" "$sec"
    '
}

fail2ban_summary() {
    have fail2ban-client || return 0
    [[ "$(systemctl is-active fail2ban 2>/dev/null)" == "active" ]] || return 0
    local jails banned=0 count=0 j
    jails="$(fail2ban-client status 2>/dev/null \
        | awk -F: '/Jail list/ {gsub(/^[ \t]+|,/,"",$2); print $2}')"
    [[ -z "$jails" ]] && return 0
    for j in $jails; do
        local n
        n="$(fail2ban-client status "$j" 2>/dev/null \
            | awk -F'[ \t]+' '/Currently banned/ {print $NF}')"
        [[ "$n" =~ ^[0-9]+$ ]] || n=0
        banned=$(( banned + n ))
        count=$(( count + 1 ))
    done
    printf '%d %d' "$count" "$banned"
}

tor_status() {
    have systemctl || return 0
    systemctl list-unit-files 2>/dev/null | grep -q '^tor\.service' || return 0
    [[ "$(systemctl is-active tor 2>/dev/null)" == "active" ]] && printf 'active' || printf 'inactive'
}

docker_status() {
    have docker || return 0
    systemctl is-active --quiet docker 2>/dev/null || return 0
    local running total
    running="$(docker ps -q 2>/dev/null | wc -l)"
    total="$(docker ps -aq 2>/dev/null | wc -l)"
    printf '%s %s' "$running" "$total"
}

# TLS cert expiry in days for a domain. Empty on error.
tls_expiry_days() {
    local domain="$1"
    [[ -z "$domain" ]] && return 0
    have openssl || return 0
    local end_date end_ts now_ts
    end_date="$(cached "tls_${domain}" 21600 -- bash -c '
        : | timeout 4 openssl s_client -servername "'"$domain"'" -connect "'"$domain"':443" 2>/dev/null \
            | openssl x509 -noout -enddate 2>/dev/null \
            | cut -d= -f2-
    ')"
    [[ -z "$end_date" ]] && return 0
    end_ts="$(date -d "$end_date" +%s 2>/dev/null)"
    [[ -z "$end_ts" ]] && return 0
    now_ts="$(date +%s)"
    printf '%d' $(( (end_ts - now_ts) / 86400 ))
}

# Last backup: mtime of $BACKUP_PATH.
last_backup_human() {
    [[ -z "$BACKUP_PATH" || ! -e "$BACKUP_PATH" ]] && return 0
    local ts now diff
    ts="$(stat -c %Y "$BACKUP_PATH" 2>/dev/null)"
    [[ -z "$ts" ]] && return 0
    now="$(date +%s)"
    diff=$(( now - ts ))
    if   (( diff < 3600 ));    then printf '%d min ago' $(( diff / 60 ))
    elif (( diff < 86400 ));   then printf '%d h ago'  $(( diff / 3600 ))
    elif (( diff < 2592000 )); then printf '%d d ago'  $(( diff / 86400 ))
    else                            printf '%d mo ago' $(( diff / 2592000 ))
    fi
}

# Next systemd timer or cron.
next_scheduled() {
    have systemctl || return 0
    systemctl list-timers --no-legend --no-pager 2>/dev/null \
        | awk 'NR==1 {for(i=1;i<=NF;i++) if($i~/\.timer$/){t=$i; break}
                      printf "%s — %s %s %s", t, $1, $2, $3; exit}'
}

