latest_release() {
    case "$DISTRO_ID" in
        ubuntu)
            cached "ubuntu_latest" "$TTL_RELEASE" -- \
                bash -c 'curl -fsSL --max-time '"$HTTP_TIMEOUT"' https://releases.ubuntu.com/ \
                    | grep -Po "Ubuntu \K[0-9]+\.[0-9]+ LTS" \
